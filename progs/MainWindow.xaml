<Window x:Class="EnemyEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор противников" Height="700" Width="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Button Name="LoadFolderButton"
                    Content="Выбрать папку с иконками"
                    Height="30"
                    Click="LoadFolderButton_Click"/>

            <ListBox Name="IconsListBox"
                     Margin="0 10 0 0"
                     Height="500"
                     HorizontalContentAlignment="Stretch"
                     SelectionChanged="IconsListBox_SelectionChanged"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    Padding="5"
                    Margin="0 0 0 10">
                <Image Name="MainEnemyIcon"
                       Width="128"
                       Height="128"
                       Stretch="Uniform"/>
            </Border>

            <Grid Grid.Row="1" Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Name="NameBox" Margin="0 2"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Иконка:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="0" Grid.Column="3" Name="IconNameBox" Margin="0 2" IsReadOnly="True"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="BaseLife:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Name="BaseLifeBox" Margin="0 2" Text="10"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="LifeModifier:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="1" Grid.Column="3" Name="LifeModifierBox" Margin="0 2" Text="1.0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="BaseGold:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Name="BaseGoldBox" Margin="0 2" Text="5"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="GoldModifier:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="2" Grid.Column="3" Name="GoldModifierBox" Margin="0 2" Text="1.0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="SpawnChance:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Name="SpawnChanceBox" Margin="0 2" Text="0.5"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 10">
                    <Button Name="AddEnemyButton"
                            Content="Добавить противника"
                            Width="130"
                            Height="30"
                            Margin="0 0 10 0"
                            Click="AddEnemyButton_Click"/>
                    <Button Name="DeleteEnemyButton"
                            Content="Удалить выбранного"
                            Width="130"
                            Height="30"
                            Margin="0 0 10 0"
                            Click="DeleteEnemyButton_Click"/>
                    <Button Name="SaveJsonButton"
                            Content="Сохранить в JSON"
                            Width="130"
                            Height="30"
                            Margin="0 0 10 0"
                            Click="SaveJsonButton_Click"/>
                    <Button Name="LoadJsonButton"
                            Content="Загрузить из JSON"
                            Width="130"
                            Height="30"
                            Margin="0 0 10 0"
                            Click="LoadJsonButton_Click"/>
                    <Button x:Name="SaveChangesButton"
                            Content="Сохранить изменения"
                            Width="130"
                            Height="30"
                            Click="SaveChangesButton_Click"/>
                </StackPanel>

                <ListBox Grid.Row="1"
                     Name="EnemiesListBox"
                     DisplayMemberPath="Name"
                     SelectionChanged="EnemiesListBox_SelectionChanged"/> 
            </Grid>
        </Grid>
    </Grid>
</Window>