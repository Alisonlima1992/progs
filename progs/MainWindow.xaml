<Window x:Class="EnemyEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор противников" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Button Name="LoadFolderButton"
                    Content="Выбрать папку с иконками"
                    Height="30"
                    Click="LoadFolderButton_Click"/>

            <ListBox Name="IconsListBox"
                     Width="400"
                     Margin="0 10 0 0"
                     HorizontalContentAlignment="Stretch"
                     SelectionChanged="IconsListBox_SelectionChanged"/>
        </StackPanel>
        
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Главная иконка противника"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    Padding="5">
                <Image Name="MainEnemyIcon"
                       Width="128"
                       Height="128"
                       Stretch="Uniform"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
    